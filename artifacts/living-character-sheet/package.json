{
  "name": "@workspace/living-character-sheet",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('.expo/types', { recursive: true })\"",
    "dev": "node scripts/start-expo-web.cjs",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.playwright.json --noEmit",
    "test:smoke": "node scripts/run-smoke.cjs",
    "test:smoke:adventure": "node scripts/run-smoke.cjs --grep \"smoke:adventure\"",
    "test:combat-qa": "node scripts/run-combat-qa.cjs && pnpm exec tsx --test tests/combat/resolveCombatAction.safety.test.cts tests/combat/zeroHpLifecycle.test.mts tests/combat/conditionDurationLifecycle.test.mts tests/combat/companionCombatPresentation.test.mts",
    "test:companion-recovery": "node --import tsx --test tests/state/companion-recovery-panel.test.cts tests/state/party-npc-instance-api.test.cts",
    "test:combat-safety": "node --import tsx --test tests/combat/adventureCombatContinuation.test.cts tests/combat/attackCardSubmission.test.cts tests/combat/playerAttackNarration.test.cts tests/combat/healingConsumable.test.cts tests/combat/lootEligibility.test.cts tests/combat/npcTacticalMovement.test.cts tests/combat/npcBehaviorBrain.test.cts tests/combat/resolveCombatAction.safety.test.cts tests/combat/composerAttackAvailability.test.mts tests/combat/gameplayProfile.test.mts tests/combat/equipmentSwitchCommand.test.mts tests/combat/npcTurnReadiness.test.mts tests/combat/combatantCapabilityProjection.test.mts tests/combat/combatantCapabilityCatalog.test.mts tests/combat/npcCommittedNarration.test.mts tests/combat/npcTurnWaitingStatus.test.mts tests/combat/combatProximity.test.mts tests/combat/targetRangeAssessment.test.mts",
    "test:campaign-checkpoints": "pnpm exec tsx --test tests/state/campaign-checkpoint-api.test.mts",
    "test:state-regression": "pnpm exec tsx --test tests/state/mutation-sync-hardening.test.mts tests/state/party-event-history.test.mts tests/state/encounter-setup-handoff.test.mts tests/state/character-import-export-contract.test.mts tests/combat/resolveCombatAction.safety.test.cts",
    "test:regression": "pnpm run test:state-regression && pnpm run test:smoke",
    "test:party-notes": "node --import tsx --test tests/state/party-notes-delivery.test.cts",
    "test:party-host": "node --import tsx --test tests/state/party-host-api.test.cts tests/state/party-member-api.test.cts tests/state/party-encounter-api.test.cts tests/state/party-roll-prompt-api.test.cts tests/state/party-mutation-api.test.cts tests/state/party-npc-instance-api.test.cts tests/state/party-npc-creation-api.test.cts",
    "test:undo-safety": "node --import tsx --test tests/state/mutation-undo-safety.test.cts tests/state/mutation-history-containment.test.cts",
    "test:snapshot-usage": "node --import tsx --test tests/state/snapshot-effect-usage.test.cts tests/state/character-effect-usage-lifecycle.test.cts",
    "build:web": "expo export --platform web --max-workers 2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/cli": "54.0.23",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@playwright/test": "^1.60.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "@ungap/structured-clone": "^1.3.1",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "^19.2.6",
    "typescript": "~5.9.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.5.4"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@types/uuid": "^11.0.0",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.22",
    "expo-sharing": "^14.0.8",
    "react-native-draggable-flatlist": "^4.0.3",
    "uuid": "^13.0.2"
  }
}
